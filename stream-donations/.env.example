# Stripe (https://dashboard.stripe.com/test/apikeys) — usa sk_test_... em teste e sk_live_... em produção
STRIPE_SECRET_KEY=sk_test_xxx
# Segredo do endpoint do webhook (whsec_...). Localmente vem do `stripe listen`; na Vercel vem do dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# StreamElements (dashboard > perfil > "Channels" > Show secrets): Account ID e JWT Token
SE_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxx
SE_JWT=eyJhbGciOi...

# Opcional: valor do campo "provider" enviado ao StreamElements (default: stripe)
# SE_TIP_PROVIDER=stripe
# Opcional: envia "imported": true na tip (default: true). Ver README.
# SE_TIP_IMPORTED=true

# URL pública do site, sem barra final (localmente: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
